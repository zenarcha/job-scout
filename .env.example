# ─────────────────────────────────────────────────────────────
# Remote PM Job Tracker — environment
# Copy to .env and fill in. NEVER commit .env. All services free-tier.
# ─────────────────────────────────────────────────────────────

# --- Supabase (Postgres) ---
# Project URL + keys. service-role is SERVER-ONLY (bypasses RLS) — never ship to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Dashboard (Next.js, D-110) ---
# The browser app reads Supabase directly, so these two are compiled into the shipped
# bundle and are PUBLIC by design — same values as SUPABASE_URL / SUPABASE_ANON_KEY above,
# duplicated because only `NEXT_PUBLIC_`-prefixed vars reach client code.
# What keeps that safe is RLS plus the column-level grants in 0015 (D-157), NOT secrecy:
# anon can read `v_jobs_public` and `remote_companies` and nothing else, and the recruiter
# columns are excluded from its grants on `jobs`/`job_enrichments` entirely.
# NEVER add SUPABASE_SERVICE_ROLE_KEY here under any name — it bypasses RLS.
# Set both in Vercel → Project → Settings → Environment Variables as well as locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI provider (free tiers). Default provider = gemini. ---
# Per-task overrides let you swap models without code changes, e.g. AI_MODEL_RECOMMEND=cerebras.
AI_PROVIDER=gemini
# One key, or several comma-separated (no spaces). GEMINI_API_KEYS works too.
#
# IMPORTANT: extra keys only raise your ceiling if each comes from a DIFFERENT Google
# project. The free-tier cap is 20 requests/day *per project* — Google's docs say
# "Rate limits are applied per project, not per API key" — so three keys generated
# inside one project still share one allowance of 20. Rotation is in lib/ai/keyPool.ts.
GEMINI_API_KEY=
# Was gemini-2.5-flash here, which Google retired mid-project (D-97) — copying this
# file would have reinstated the exact outage the pinned default exists to prevent.
GEMINI_MODEL=gemini-3.6-flash
# Optional alternates (OpenAI-compatible endpoints)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
GROK_API_KEY=
GROK_MODEL=grok-2-latest
# Groq (D-124) — free tier, 30 req/MINUTE and 1,000/day, vs Gemini's 20/day per project.
# Key: console.groq.com/keys (no card required).
# ⚠️ GROQ IS NOT GROK. GROK_API_KEY above is xAI (paid, api.x.ai). This is Groq
# (free, api.groq.com). One letter apart — D-113 already confused the two once.
# ⚠️ THE MODEL SETS THE DAILY CEILING: llama-3.3-70b-versatile = 1,000/day (default,
# stronger); llama-3.1-8b-instant = 14,400/day but weaker at strict JSON contracts.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional per-stage provider overrides: gemini | cerebras | grok
AI_PROVIDER_CLASSIFY=
AI_PROVIDER_RESUME_MATCH=
AI_PROVIDER_SKILLS=
AI_PROVIDER_RECOMMEND=

# --- Apify (scraping) ---
APIFY_TOKEN=
# Shared secret we validate on the inbound Apify webhook (set the same value in the Apify webhook headers)
APIFY_WEBHOOK_SECRET=

# --- Telegram (instant alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notion (tracker) ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- App ---
# Comma-separated absolute prefixes considered "India-eligible remote". Tune as needed.
REMOTE_INDIA_KEYWORDS=india,remote india,anywhere,worldwide,global,asia
# Ingest pre-filter: 'on' (default) drops obviously on-site roles at ingest; 'off' keeps everything.
# D-104: off by default — the AI (classify.remote_type, plus geo_recheck for assumed cases)
# owns the remote verdict. The old regex pre-filter was wrong on half its real drops.
# Set to "on" to re-enable the cheap location-tag check if AI call volume needs cutting.
INGEST_REMOTE_FILTER=off
