{
  "name": "remote-pm-job-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Always-on, free-to-run tracker that discovers remote (India-eligible) PM-track roles, enriches them with AI, and delivers matches to a dashboard, Notion, and Telegram.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/run-ingest.ts",
    "enrich": "tsx scripts/run-enrich.ts",
    "dispatch": "tsx scripts/run-dispatch.ts",
    "notify": "tsx scripts/run-notify.ts",
    "test:golden": "tsx tests/golden/run.ts",
    "ats:poll": "tsx scripts/run-ats-poll.ts",
    "linkcheck": "tsx scripts/run-linkcheck.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "p-retry": "^6.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
